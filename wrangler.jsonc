{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mowojang-discord-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
